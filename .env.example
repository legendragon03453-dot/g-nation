# Chaves do Supabase (projeto gnation). Copie para .env.local e preencha.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------
# INTEGRAÇÃO SHOPIFY (pagamento)
# ----------------------------------------------------------------------
# Estas duas são PÚBLICAS (vão no bundle do site, sem problema) — o token
# do Storefront só cria carrinho e lê a vitrine, não acessa conta/pedidos.
#
# Onde pegar no painel do Shopify do cliente:
#   VITE_SHOPIFY_DOMAIN           → o domínio .myshopify.com da loja
#                                    (ex: gnation.myshopify.com)
#   VITE_SHOPIFY_STOREFRONT_TOKEN → Configurações → Apps e canais de venda
#                                    → Desenvolver apps → criar app →
#                                    Storefront API → "Storefront API access
#                                    token"
VITE_SHOPIFY_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=
VITE_SHOPIFY_API_VERSION=2025-01

# ----------------------------------------------------------------------
# SEGREDOS DO SERVIDOR — NÃO vão aqui nem no bundle.
# Vão nos "secrets" das Edge Functions do Supabase (supabase secrets set):
#   SHOPIFY_WEBHOOK_SECRET        → segredo do webhook (Shopify → Notif. →
#                                    ao criar o webhook orders/paid)
#   SUPABASE_SERVICE_ROLE_KEY     → já existe no projeto (painel Supabase)
# ----------------------------------------------------------------------
